# Copia este archivo a .env y completá los valores

# --- Envío de mails con tu propia cuenta de Gmail ---
# 1. Activá la verificación en 2 pasos en tu cuenta de Google (myaccount.google.com/security)
# 2. Generá una "Contraseña de aplicación" en myaccount.google.com/apppasswords
# 3. Pegá tu Gmail y esa contraseña de 16 caracteres acá abajo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx

# Nombre que aparece como remitente
APP_NAME=Check-In

# Secreto para firmar las sesiones (cambialo por cualquier texto largo al azar)
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Puerto (Railway/Render lo asignan solos, no hace falta tocarlo)
PORT=3000

# Carpeta donde se guarda data.json. En producción (Railway/Render) apuntá
# esto a la carpeta donde montaste el Volume persistente, para que los
# usuarios y contactos no se borren en cada redeploy. Si lo dejás vacío,
# se guarda dentro de la carpeta del proyecto (sirve para correrlo local).
DATA_DIR=

# --- Notificaciones push (opcional, pero recomendado) ---
# Sin estas claves la app funciona igual, pero no manda notificaciones push.
# Para generarlas, corré este comando UNA VEZ y pegá el resultado acá abajo:
#
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
#
# Guardá estas claves: si las cambiás más adelante, todos los usuarios van
# a tener que volver a activar las notificaciones.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Un mail de contacto tuyo (lo exige el protocolo push, no se muestra a nadie)
VAPID_SUBJECT=mailto:tu-correo@gmail.com
